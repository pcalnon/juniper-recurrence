# Build context hygiene for the juniper-recurrence app image (OUT-4).
# The build only needs pyproject.toml, README.md, and juniper_recurrence/.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
**/.coverage
.coverage.*
htmlcov/
**/htmlcov/
tests/
CHANGELOG.md
.git/
.gitignore
*.md.bak
dist/
build/

# -- Credentials. Docker does NOT honour .gitignore, and this image is PUBLIC.
#    The Dockerfile copies a DIRECTORY allowlist, which is not a file allowlist:
#    `COPY <pkg>/ ./<pkg>/` ships everything tracked beneath it. Patterns are
#    root-anchored (Go filepath.Match), so the `**/` twins are load-bearing.
secrets/
**/secrets/
*.key
**/*.key
*.pem
**/*.pem
*.p12
*.pfx
.env
.env.*
**/.env
**/.env.*
!.env.example
