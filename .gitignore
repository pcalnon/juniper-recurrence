# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Linter caches
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Lockfiles regenerated by tooling (kept per-package when relevant)
# requirements.lock is intentionally tracked when present.

# Data / artifacts (datasets are juniper-data's responsibility, never vendored here)
data/
*.npz

# G-5 benchmark figures (bench.plots). Regenerable from the committed results JSON + the
# dataset seeds, so the PNGs are outputs, not baselines — bench/results/ stays the tracked
# baseline home. Point --out-dir elsewhere for a run you want to keep.
bench/plots/

# Recurrence snapshot ARTIFACTS. The snapshot root juniper-deploy bind-mounts (W1.12,
# juniper-deploy#242) is `<repo>/recurrence-snapshots/`, the repo root, so the whole-tree
# offline backup captures the files and git never does. DIRECTORY-anchored, in the `/*`
# form rather than `/recurrence-snapshots/`: git cannot re-include anything under an
# excluded directory, and the .gitkeep below must ship -- a missing bind-mount source is
# created root-owned by the Docker daemon, which then EPERMs the uid-1000 container on
# every save. Mirrors juniper-cascor's /cascor-snapshots/* rule (juniper-cascor#548).
/recurrence-snapshots/*
!/recurrence-snapshots/.gitkeep
