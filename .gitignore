# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Linter caches
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Lockfiles regenerated by tooling (kept per-package when relevant)
# requirements.lock is intentionally tracked when present.

# Data / artifacts (datasets are juniper-data's responsibility, never vendored here)
data/
*.npz

# G-5 benchmark figures (bench.plots). Regenerable from the committed results JSON + the
# dataset seeds, so the PNGs are outputs, not baselines — bench/results/ stays the tracked
# baseline home. Point --out-dir elsewhere for a run you want to keep.
bench/plots/
